ALPACA_API_KEY=replace_me
ALPACA_API_SECRET=replace_me
BRONTIDE_DB_PATH=./data/brontide.duckdb
BRONTIDE_API_HOST=127.0.0.1
BRONTIDE_API_PORT=8765
BRONTIDE_ALPACA_BATCH_SIZE=200
## Optional; defaults beside BRONTIDE_DB_PATH as brontide.published.duckdb.
BRONTIDE_PUBLISHED_DB_PATH=./data/brontide.published.duckdb
BRONTIDE_EOD_CLOSE_DELAY_MINUTES=30
BRONTIDE_EOD_CORRECTION_OVERLAP_SESSIONS=5
BRONTIDE_EOD_MINIMUM_COVERAGE_PERCENT=99
## Optional authoritative TC2000 candidate/rank/result export. Relative paths resolve beside this env file.
# BRONTIDE_TC2000_UNIVERSE_PATH=./data/tc2000-biggest-one-month-universes.json
BRONTIDE_TC2000_UNIVERSE_STALE_SESSIONS=5
## IBKR Gate 2 is local, paper-only and submission-disabled by default.
## Never treat the host/port or account naming convention as proof of paper.
BRONTIDE_IBKR_HOST=127.0.0.1
BRONTIDE_IBKR_PORT=0
BRONTIDE_IBKR_CLIENT_ID=0
BRONTIDE_IBKR_ACCOUNT_ID=
BRONTIDE_IBKR_VERIFICATION_FILE=
BRONTIDE_IBKR_SUBMISSIONS_ENABLED=false
